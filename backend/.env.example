# Application Settings
APP_NAME="AI Revenue Recovery Agent"
DEBUG=True

# MySQL Database (Optional - comment out to disable)
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=revenue_recovery

# Razorpay Credentials (Use test/sandbox keys)
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_SECRET_KEY
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# LLM Provider API Keys
# Groq API - Used for enhanced explanations (optional but recommended)
# Get your free API key at: https://console.groq.com/keys
# Model used: openai/gpt-oss-20b (fast inference, production-ready)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Gemini API - Legacy support (not currently used)
GEMINI_API_KEY=your_gemini_key

# Recovery Action Settings
MAX_RETRY_ATTEMPTS=3
AUTO_ACTION_THRESHOLD=10000
HIGH_VALUE_THRESHOLD=50000

# LLM Settings
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1000
LLM_TIMEOUT=30
