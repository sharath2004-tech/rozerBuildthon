# Provider used for message generation and failure classification only.
# The system runs fully without this key (deterministic template fallback).
GEMINI_API_KEY=

# Razorpay TEST-MODE credentials only. Never use live keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Policy configuration
AUTO_ACTION_VALUE_CEILING_INR=5000
MAX_RETRY_ATTEMPTS=3
QUIET_HOURS_START=21
QUIET_HOURS_END=9
